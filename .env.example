GCP_PROJECT_ID=your-gcp-project-id
PAXOSBUS_PORT=port-value
GCP_GOARCH=your-vm-architecture

# Multi-machine: one VM per entry, formatted as VM_NAME:ZONE (or VM_NAME:ZONE:LABEL).
# Replicas are ordered by ID starting at 0; the first is the leader.
GCP_REPLICAS="
your-replica-0-vm:your-replica-0-zone
your-replica-1-vm:your-replica-1-zone
your-replica-2-vm:your-replica-2-zone
"
# Clients are ordered by ID starting at 0. Add or remove entries as needed.
GCP_CLIENTS="
your-client-0-vm:your-client-0-zone
your-client-1-vm:your-client-1-zone
your-client-2-vm:your-client-2-zone
your-client-3-vm:your-client-3-zone
your-client-4-vm:your-client-4-zone
your-client-5-vm:your-client-5-zone
your-client-6-vm:your-client-6-zone
your-client-7-vm:your-client-7-zone
"

# Single-machine: client and replicas run on same VM; the lists above are ignored.
GCP_SINGLE_VM=your-single-vm-name
GCP_SINGLE_ZONE=your-single-vm-zone

# Ignored in multi-machine experiments
PAXOSBUS_REPLICA_COUNT=your-replica-count
PAXOSBUS_CLIENT_COUNT=your-client-count
