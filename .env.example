# Copy this file to .env and replace each placeholder with your GCP values.
GCP_PROJECT_ID=your-gcp-project-id

GCP_US_VM=your-us-instance
GCP_US_ZONE=your-us-zone

GCP_EUROPE_VM=your-europe-instance
GCP_EUROPE_ZONE=your-europe-zone

GCP_ASIA_VM=your-asia-instance
GCP_ASIA_ZONE=your-asia-zone

GCP_SOUTHAMERICA_VM=your-south-america-instance
GCP_SOUTHAMERICA_ZONE=your-south-america-zone

PAXOSBUS_PORT=7000
GCP_GOARCH=amd64
STOP_VMS_AFTER_RUN=1
